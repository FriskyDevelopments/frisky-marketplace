# Copy to .env (gitignored) OR better: run with `op run --env-file=.env.example -- <cmd>`.
# Values are 1Password references, never literal secrets.
# Vault: FriskyDev-Infra
CLOUDFLARE_API_TOKEN=op://FriskyDev-Infra/<cloudflare-item>/credential
SUPERMEMORY_API_KEY=op://FriskyDev-Infra/<supermemory-item>/credential
GITHUB_TOKEN=op://FriskyDev-Infra/<github-item>/credential
EXAMPLE_PLUGIN_API_KEY=<PLACEHOLDER>
